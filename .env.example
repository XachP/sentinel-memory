# Tatum: free key from https://dashboard.tatum.io (without one, the Sui gateway allows 5 requests/min, enough for one run)
TATUM_API_KEY=
# Walrus Memory (mainnet). Create the account at https://memory.walrus.xyz (Connect wallet; gas is sponsored)
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
# auto (default): standard relayer remember, falling back per item to manual (local SEAL + local embedding)
# MEMWAL_WRITE_MODE=auto
# Optional: watch your own Suilend obligation(s) instead of config/watch.json
# WATCH_OBLIGATIONS=0xobligationid:My loan
